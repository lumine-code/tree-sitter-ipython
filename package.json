{
  "name": "@lumine-code/tree-sitter-ipython",
  "author": "lumine-code",
  "version": "1.0.0",
  "description": "Parses IPython source files with Tree-sitter.",
  "main": "bindings/node",
  "types": "bindings/node",
  "repository": "https://github.com/lumine-code/tree-sitter-ipython",
  "bugs": "https://github.com/lumine-code/tree-sitter-ipython/issues",
  "homepage": "https://github.com/lumine-code/tree-sitter-ipython",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@11.16.0",
  "keywords": [
    "tree-sitter",
    "ipython",
    "python",
    "jupyter",
    "parser",
    "lumine"
  ],
  "files": [
    "bindings/node",
    "grammar.js",
    "queries",
    "src",
    "tree-sitter.json",
    "binding.gyp"
  ],
  "dependencies": {
    "node-addon-api": "^8.9.2",
    "node-gyp-build": "^4.8.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "tree-sitter": "^0.25.0",
    "tree-sitter-cli": "0.27.0"
  },
  "peerDependencies": {
    "tree-sitter": "^0.25.0"
  },
  "peerDependenciesMeta": {
    "tree-sitter": {
      "optional": true
    }
  },
  "scripts": {
    "build": "npm run generate && npm run build:native",
    "build:native": "node-gyp rebuild",
    "build:wasm": "tree-sitter build --wasm",
    "check:format": "prettier --check .",
    "check:generated": "node scripts/check-generated.js",
    "format": "prettier --write .",
    "generate": "tree-sitter generate",
    "install": "node-gyp-build",
    "lint": "eslint .",
    "test": "npm run lint && npm run check:format && npm run check:generated && npm run build:native && node --test bindings/node/binding_test.js && tree-sitter test"
  }
}
