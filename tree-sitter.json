{
  "grammars": [
    {
      "name": "ipython",
      "camelcase": "IPython",
      "scope": "source.python.ipy",
      "path": ".",
      "file-types": ["ipy"],
      "highlights": "queries/highlights.scm",
      "tags": "queries/tags.scm"
    }
  ],
  "metadata": {
    "version": "1.0.0",
    "license": "MIT",
    "description": "Parses IPython source files with Tree-sitter.",
    "authors": [
      {
        "name": "lumine-code"
      },
      {
        "name": "Max Brunsfeld"
      },
      {
        "name": "Amaan Qureshi"
      }
    ],
    "links": {
      "repository": "https://github.com/lumine-code/tree-sitter-ipython"
    }
  },
  "bindings": {
    "node": true
  }
}
